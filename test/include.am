# vim:ft=automake
# included from Top Level Makefile.am
# All paths should be given relative to the root

TEST_EXTENSIONS=.test
TESTS += $(check_PROGRAMS)

check_PROGRAMS += test/cmac_cleanup.test test/cmac_cleanup_inline.test \
                  test/cmac_cleanup_buffered.test
test_cmac_cleanup_test_SOURCES = test/test_cmac_compat.c
test_cmac_cleanup_inline_test_SOURCES = test/test_cmac_compat.c
test_cmac_cleanup_inline_test_CPPFLAGS = $(AM_CPPFLAGS) -DWE_TEST_CMAC_INLINE
test_cmac_cleanup_buffered_test_SOURCES = test/test_cmac_compat.c
test_cmac_cleanup_buffered_test_CPPFLAGS = $(AM_CPPFLAGS) -DWE_TEST_CMAC_BUFFERED

check_PROGRAMS += test/unit.test
noinst_PROGRAMS += test/unit.test
DISTCLEANFILES += test/.libs/unit.test

check_PROGRAMS += test/pbe_lifetime.test
noinst_PROGRAMS += test/pbe_lifetime.test
DISTCLEANFILES += test/.libs/pbe_lifetime.test

test_pbe_lifetime_test_SOURCES = test/test_pbe_lifetime.c
test_pbe_lifetime_test_LDADD = $(OPENSSL_LIBS)

check_PROGRAMS += test/engine_lifetime.test
noinst_PROGRAMS += test/engine_lifetime.test
DISTCLEANFILES += test/.libs/engine_lifetime.test

test_engine_lifetime_test_SOURCES = test/test_engine_lifetime.c
test_engine_lifetime_test_LDADD = $(OPENSSL_LIBS)

check_PROGRAMS += test/engine_pbe_init.test
noinst_PROGRAMS += test/engine_pbe_init.test
DISTCLEANFILES += test/.libs/engine_pbe_init.test

test_engine_pbe_init_test_SOURCES = test/test_engine_pbe_init.c
test_engine_pbe_init_test_LDADD = libwolfengine.la

if BUILD_STATIC_TESTS
check_PROGRAMS += test/pbe_static.test
noinst_PROGRAMS += test/pbe_static.test
DISTCLEANFILES += test/.libs/pbe_static.test

test_pbe_static_test_SOURCES = test/test_pbe_lifetime.c
test_pbe_static_test_CPPFLAGS = $(AM_CPPFLAGS) -DWE_PBE_STATIC_LINK
test_pbe_static_test_LDFLAGS = $(AM_LDFLAGS) -static
test_pbe_static_test_LDADD = libwolfengine.la
endif

test_unit_test_SOURCES = \
	test/test_aestag.c \
	test/test_cipher.c \
	test/test_cmac.c \
	test/test_dh.c \
	test/test_digest.c \
	test/test_ecc.c \
	test/test_hkdf.c \
	test/test_hmac.c \
	test/test_logging.c \
	test/test_pbe.c \
	test/test_pkey.c \
	test/test_rand.c \
	test/test_rsa.c \
	test/test_tls1_prf.c \
	test/unit.c
test_unit_test_LDADD = libwolfengine.la
noinst_HEADERS += test/unit.h
