diff --git a/crypto/dh/dhtest.c b/crypto/dh/dhtest.c
--- a/crypto/dh/dhtest.c
+++ b/crypto/dh/dhtest.c
@@ -140,5 +140,13 @@
     BN_GENCB_set(&_cb, &cb, out);
